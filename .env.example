# Copy this file to .env on the server and fill real production values.
# Do not commit the filled .env file.

POSTGRES_DB=neondb
DB_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace-with-neon-password
JWT_SECRET=change-this-secret-min-32-chars

NEON_PROJECT_ID=old-resonance-75447224
NEON_BRANCH=production
NEON_AUTH_URL=https://YOUR_NEON_AUTH_HOST/neondb/auth
NEON_JWKS_URL=https://YOUR_NEON_AUTH_HOST/neondb/auth/.well-known/jwks.json

# Public URLs. APP_FRONTEND_URL and CORS_ALLOWED_ORIGINS must match your frontend domain.
APP_FRONTEND_URL=https://achanvear.site
CORS_ALLOWED_ORIGINS=https://achanvear.site,https://www.achanvear.site,http://localhost:3000

# Ports exposed by Docker on the host.
BACKEND_PORT=8081
POSTGRES_PORT=5433
REDIS_PORT=6380
AI_AGENT_PORT=8001

# Culqi.
CULQI_PUBLIC_KEY=pk_test_3GaFfV2020niFpxr
CULQI_SECRET_KEY=sk_test_REPLACE_ME
CULQI_BASE_URL=https://api.culqi.com/v2
CULQI_CURRENCY_CODE=PEN

# Optional external services.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Achanvear
APIS_PERU_TOKEN=
N8N_NOTIFICATIONS_WEBHOOK_URL=
COMPANY_REPORT_EMAIL=

# AI provider used by both Java backend suggestions and Python agent.
AI_PROVIDER=deepseek
LLM_PROVIDER=deepseek
MOCK_LLM=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

