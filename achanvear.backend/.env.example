# Base de datos
DB_URL=jdbc:postgresql://postgres:5432/achanvear
DB_USERNAME=postgres
DB_PASSWORD=replace-with-db-password

# JWT
JWT_SECRET=my-super-secret-key-min-32-chars-long-for-dev-only

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=achanvear-recordings-dev

# Mercado Pago
MP_PUBLIC_KEY=your-mp-public-key
MP_ACCESS_TOKEN=your-mp-access-token

# Brevo (Email)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-email@example.com
BREVO_SENDER_NAME=Achanvear

# AI API (Python backend)
AI_API_URL=http://host.docker.internal:8001
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
